# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/

# Local test outputs (workdirs with generated parquets)
tests/local/workdir*/
# config_adobe lo regenera make_config() en cada corrida de adobe_e2e
tests/local/config_adobe/
tests/local/__pycache__/
# Snapshots y artefactos del harness de reanudación / depuración local
tests/local/snap_*/
tests/local/resume_baseline.json
tests/local/_dbg*.py
tests/local/email_drafts/
# fichero accidental: redirects a "nul" en git-bash crean un archivo real
tests/local/nul
# correos .eml del dry-run de EmailSender (LAIKA_EMAIL_DRY_RUN_DIR)
*.eml

# Local Hadoop binaries for Windows Spark (re-downloadable, see
# tests/local/README.md)
tests/local/hadoop/bin/*.dll
tests/local/hadoop/bin/*.exe

# Spark / framework jars
*.jar

# Logs & OS files
*.log
.DS_Store
Thumbs.db

# Scratch local: fotos de mails/config, scripts temporales, crops, shims
tmp/

# Artefactos locales de Spark/Hive (warehouse, metastore derby)
spark-warehouse/
metastore_db/
derby.log
spark-events/
*.crc

*/tmp/*